model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  partyTags PartyTag[]
}

model PartyTag {
  id      Int @id @default(autoincrement())
  partyId Int
  tagId   Int

  party Party @relation(fields: [partyId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@index([partyId])
  @@index([tagId])
}