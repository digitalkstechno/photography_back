model Company {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  apiKey    String   @unique

  email     String?
  phone     String?
  address   String?

  gstNumber String?
  logoUrl   String?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔷 Business Layer
  users        User[]
  parties      Party[]
  transactions Transaction[]
  bookings     Booking[]

  // 🔷 Accounting Layer
  accounts       Account[]
  journalEntries JournalEntry[]

  @@index([slug])
}