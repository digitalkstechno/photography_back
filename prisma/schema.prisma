// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique // used in URLs (e.g. shadikaladdu)
  apiKey    String   @unique // for API access

  email     String?
  phone     String?
  address   String?

  gstNumber String?
  logoUrl   String?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  parties      Party[]
  transactions Transaction[]
  bookings     Booking[]
  ledger       LedgerEntry[]

  @@index([slug])
}

model PartyType {
  id   Int    @id @default(autoincrement())
  name String @unique

  parties Party[]
}

model Party {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  partyTypeId Int
  createdAt   DateTime @default(now())

  partyType     PartyType     @relation(fields: [partyTypeId], references: [id])
  transactions  Transaction[]
  bookings      Booking[]
  ledgerEntries LedgerEntry[]

  tags PartyTag[]

  @@index([partyTypeId])
  companies Company[]
}

model LedgerEntry {
  id              Int      @id @default(autoincrement())
  partyId         Int
  date            DateTime @default(now())
  description     String?
  amount          Float
  type            String // DEBIT (Out/Expense), CREDIT (In/Income)
  category        String? // e.g., "Payment Received", "Expense", "Refund", "Advance"
  paymentMethodId Int?
  transactionId   Int? // Optional link to an Invoice/Transaction
  createdAt       DateTime @default(now())

  party         Party          @relation(fields: [partyId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])

  @@index([partyId])
  @@index([date])
  @@index([transactionId])
  companies Company[]
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  partyTags PartyTag[]
}

model PartyTag {
  id      Int @id @default(autoincrement())
  partyId Int
  tagId   Int

  party Party @relation(fields: [partyId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@index([partyId])
  @@index([tagId])
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  shortName String?
  createdAt DateTime @default(now())

  items Item[]
}

model ItemCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  items Item[]
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  unitId      Int
  categoryId  Int?
  isService   Boolean  @default(true)
  createdAt   DateTime @default(now())

  unit     Unit          @relation(fields: [unitId], references: [id])
  category ItemCategory? @relation(fields: [categoryId], references: [id])

  transactionItems TransactionItem[]
  packageItems     PackageItem[]

  @@index([unitId])
}

model Package {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  days        Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        PackageItem[]
  bookings     Booking[]
  transactions Transaction[]

  @@index([name])
}

model PackageItem {
  id        Int @id @default(autoincrement())
  packageId Int
  itemId    Int
  quantity  Int @default(1)

  package Package @relation(fields: [packageId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@index([packageId])
  @@index([itemId])
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  password       String
  role           String         @default("admin") // admin, manager, staff, freelancer
  phone          String?
  skillset       String?
  equipment      String?
  charges        Float?
  isFreelance    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  assignedEvents BookingEvent[]
  availabilities Availability[]
  equipmentItems Equipment[]    @relation("UserEquipment")

  companies Company[]
}

model Equipment {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // Camera, Drone, Light, etc.
  serialNo  String?
  dailyRate Float?
  ownerId   Int?
  status    String   @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE
  createdAt DateTime @default(now())

  owner User? @relation("UserEquipment", fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Availability {
  id        Int      @id @default(autoincrement())
  userId    Int? // If null, it's a studio-wide holiday/block
  date      DateTime
  isBlocked Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}

model TransactionType {
  id   Int    @id @default(autoincrement())
  name String @unique

  transactions Transaction[]
}

model TransactionStatus {
  id   Int    @id @default(autoincrement())
  name String @unique

  transactions Transaction[]
}

model Transaction {
  id                Int      @id @default(autoincrement())
  partyId           Int
  transactionTypeId Int
  statusId          Int
  referenceId       Int?
  packageId         Int?
  total             Float
  notes             String?
  createdAt         DateTime @default(now())

  party           Party             @relation(fields: [partyId], references: [id])
  transactionType TransactionType   @relation(fields: [transactionTypeId], references: [id])
  status          TransactionStatus @relation(fields: [statusId], references: [id])
  package         Package?          @relation(fields: [packageId], references: [id])

  items         TransactionItem[]
  payments      Payment[]
  bookings      Booking[]
  ledgerEntries LedgerEntry[]

  @@index([partyId])
  @@index([transactionTypeId])
  @@index([statusId])
  @@index([packageId])
  companies Company[]
}

model TransactionItem {
  id            Int    @id @default(autoincrement())
  transactionId Int
  itemId        Int
  quantity      Float
  price         Float
  total         Float?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  item        Item        @relation(fields: [itemId], references: [id])

  @@index([transactionId])
  @@index([itemId])
}

model PaymentMethod {
  id   Int    @id @default(autoincrement())
  name String @unique

  payments      Payment[]
  ledgerEntries LedgerEntry[]
}

model Payment {
  id              Int      @id @default(autoincrement())
  transactionId   Int
  paymentMethodId Int
  amount          Float
  reference       String?
  createdAt       DateTime @default(now())

  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([transactionId])
}

model Booking {
  id          Int      @id @default(autoincrement())
  studioId    Int? // For future multi-studio SaaS
  customerId  Int // References Party.id
  quotationId Int? // References Transaction.id (optional, can create direct booking)
  packageId   Int? // References Package.id
  status      String   @default("TENTATIVE") // TENTATIVE, CONFIRMED, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Party          @relation(fields: [customerId], references: [id])
  quotation Transaction?   @relation(fields: [quotationId], references: [id])
  package   Package?       @relation(fields: [packageId], references: [id])
  events    BookingEvent[]

  @@index([customerId])
  @@index([studioId])
  @@index([packageId])
  companies Company[]
}

model BookingEvent {
  id             Int       @id @default(autoincrement())
  studioId       Int? // For future multi-studio SaaS
  bookingId      Int
  eventType      String // e.g., "Wedding", "Haldi"
  eventDate      DateTime // Standardized to midnight or specific time
  eventEndDate   DateTime? // If event spans time
  location       String?
  photographerId Int? // References User.id assigned to this event
  notes          String?

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photographer User?   @relation(fields: [photographerId], references: [id])

  @@index([bookingId])
  @@index([eventDate])
  @@index([studioId])
}
