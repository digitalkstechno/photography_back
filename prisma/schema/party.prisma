model Party {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  partyType PartyType
  createdAt DateTime  @default(now())

  // Relations
  transactions Transaction[]
  bookings     Booking[]
  tags         PartyTag[]

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  accounts Account[]

  @@index([companyId])
}
enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
}