enum UserRole {
  ADMIN
  MANAGER
  STAFF
  FREELANCER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  role      UserRole @default(ADMIN)

  phone       String?
  skillset    String?
  equipment   String?
  charges     Decimal? @db.Decimal(10, 2)
  isFreelance Boolean  @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  // Relations
  assignedEvents BookingEvent[]
  availabilities Availability[]
  equipmentItems Equipment[] @relation("UserEquipment")

  @@index([companyId])
}